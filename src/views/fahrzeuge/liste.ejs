<%- include('../layout', { active }) %>
  <h1>Fahrzeuge</h1>

  <div class="filter-bar">
    <a href="/fahrzeuge" class="<%= filter === 'alle' ? 'active' : '' %>">Alle</a>
    <a href="/fahrzeuge?typ=EV" class="<%= filter === 'EV' ? 'active' : '' %>">Elektro</a>
    <a href="/fahrzeuge?typ=ICE" class="<%= filter === 'ICE' ? 'active' : '' %>">Verbrenner</a>
  </div>

  <div class="actions">
    <a href="/fahrzeuge/neu" class="btn btn-primary">Neues Fahrzeug</a>
  </div>

  <% if (fahrzeuge.length === 0) { %>
    <div class="empty-state">
      <p>Noch keine Fahrzeuge angelegt.</p>
    </div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Typ</th>
          <th>Listenpreis</th>
          <th>Kaufpreis</th>
          <th>Leistung</th>
          <th>Verbrauch</th>
          <th>10–80%</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% fahrzeuge.forEach(f => { %>
          <tr>
            <td><%= f.name %></td>
            <td><span class="badge <%= f.typ === 'EV' ? 'ev' : 'ice' %>"><%= f.typ %></span></td>
            <td><%= f.listenpreis ? f.listenpreis.toLocaleString('de-DE') + ' \u20ac' : '\u2014' %></td>
            <td><%= f.kaufpreis.toLocaleString('de-DE') %> &euro;</td>
            <td><%- f.leistung_kw ? f.leistung_kw + ' kW (' + Math.round(f.leistung_kw * 1.35962) + ' PS)' : '&mdash;' %></td>
            <td>
              <% if (f.typ === 'EV') { %>
                <%- f.stromverbrauch_kwh ? f.stromverbrauch_kwh + ' kWh/100km' : '&mdash;' %>
              <% } else { %>
                <%- f.verbrauch_l ? f.verbrauch_l + ' L/100km' : '&mdash;' %>
              <% } %>
            </td>
            <td><%- f.ladezeit_min ? f.ladezeit_min + ' min' : '&mdash;' %></td>
            <td class="row-actions">
              <a href="/fahrzeuge/<%= f.id %>" class="btn btn-secondary">Bearbeiten</a>
              <form action="/fahrzeuge/<%= f.id %>/delete" method="POST" class="inline-form">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Wirklich l\u00f6schen?')">L&ouml;schen</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>
</body>
</html>
